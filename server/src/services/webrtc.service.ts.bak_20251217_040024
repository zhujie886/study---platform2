import { Server as SocketServer, Socket } from 'socket.io';

export function initWebRTCSignaling(io: SocketServer) {
  const webrtcNamespace = io.of('/webrtc');
  webrtcNamespace.on('connection', (socket: Socket) => {
    handleSocketConnection(socket, webrtcNamespace);
  });
}

// ✅ 修复：将连接逻辑拆分到独立函数
function handleSocketConnection(socket: Socket, namespace: any) {
    let currentRoomId: string | null = null;
    let currentUserId: string | null = null;

    const handle = (event: string, handler: (data: any) => void) => {
        socket.on(event, (data) => {
            try {
                handler(data);
            } catch (error) {
                console.error(`Error in socket event '${event}':`, error);
            }
        });
    };

    handle('join-room', (data) => {
        currentRoomId = data.roomId;
        currentUserId = data.userId;
        (socket as any).userId = data.userId;
        socket.join(data.roomId);
        socket.to(data.roomId).emit('user-joined', { userId: data.userId, socketId: socket.id });
        // ... (获取现有用户逻辑)
    });

    handle('offer', (data) => socket.to(data.targetSocketId).emit('offer', { fromSocketId: socket.id, offer: data.offer }));
    handle('answer', (data) => socket.to(data.targetSocketId).emit('answer', { fromSocketId: socket.id, answer: data.answer }));
    handle('ice-candidate', (data) => socket.to(data.targetSocketId).emit('ice-candidate', { fromSocketId: socket.id, candidate: data.candidate }));

    handle('gesture', (data) => {
        if (currentRoomId) socket.to(currentRoomId).emit('gesture', { userId: currentUserId, gesture: data.gesture });
    });

    handle('caption', (data) => {
        if (currentRoomId) socket.to(currentRoomId).emit('caption', { userId: currentUserId, text: data.text });
    });

    socket.on('disconnect', () => {
        if (currentRoomId && currentUserId) {
            socket.to(currentRoomId).emit('user-left', { userId: currentUserId, socketId: socket.id });
        }
    });
}