import { Server, Socket } from 'socket.io';
import { initWebRTCSignaling } from './webrtc.service';

let io: Server;

export function initializeSocketServer(socketServer: Server) {
  io = socketServer;
  initWebRTCSignaling(io);

  io.on('connection', (socket: Socket) => {
    // 修复: 健壮的房间加入逻辑
    socket.on('join', (userId: string) => {
      if (!userId) return;

      // 防止重复加入
      const roomName = `user-${userId}`;
      if (!socket.rooms.has(roomName)) {
          socket.join(roomName);
          console.log(`User ${userId} joined room`);
      }

      socket.emit('joined', { userId, socketId: socket.id });
    });

    socket.on('leave', (userId: string) => {
      if (!userId) return;
      socket.leave(`user-${userId}`);
    });

    // 业务逻辑事件处理...
    socket.on('memo:sync', (data) => {
      const { userId, memo } = data;
      socket.to(`user-${userId}`).emit('memo:updated', memo);
    });

    // ... 其他事件保持不变，确保错误捕获
    socket.on('error', (err) => {
        console.error('Socket error:', err);
    });
  });

  return io;
}

export function getSocketServer(): Server {
  if (!io) {
    throw new Error('Socket server not initialized');
  }
  return io;
}

export function sendNotificationToUser(userId: string, notification: any) {
  if (io) {
    io.to(`user-${userId}`).emit('notification:received', notification);
  }
}