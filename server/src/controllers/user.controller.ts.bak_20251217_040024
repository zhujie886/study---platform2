import { Request, Response } from 'express';
import prisma from '../utils/prisma';
import jwt from 'jsonwebtoken';
import bcrypt from 'bcryptjs';

const JWT_SECRET = process.env.JWT_SECRET;

if (!JWT_SECRET) {
  throw new Error('JWT_SECRET is not defined in the environment variables');
}

const isBcryptHash = (v: string) =>
  typeof v === 'string' && (v.startsWith('$2a$') || v.startsWith('$2b$') || v.startsWith('$2y$'));

const norm = (v: any) => (typeof v === 'string' ? v.trim() : '');

const hasAt = (v: string) => v.includes('@');

const defaultUsername = (email: string) => {
  const idx = email.indexOf('@');
  return idx > 0 ? email.slice(0, idx) : email;
};

export const register = async (req: Request, res: Response) => {
  try {
    const { username, password, email } = req.body;

    const email2 = norm(email);
    const username2 = norm(username);

    if (!email2 || !hasAt(email2)) {
      return res.status(400).json({ error: '邮箱格式不正确：只需要包含 @ 即可' });
    }
    if (!password) {
      return res.status(400).json({ error: '密码不能为空' });
    }

    const finalUsername = username2 || defaultUsername(email2);
    const hashed = await bcrypt.hash(password, 10);

    const user = await prisma.user.create({
      data: {
        username: finalUsername,
        email: email2,
        password: hashed
      }
    });

    return res.json(user);
  } catch (e) {
    return res.status(400).json({ error: '注册失败：邮箱可能已被使用' });
  }
};

export const login = async (req: Request, res: Response) => {
  try {
    console.log('[users/login] hit');

    const { email, username, identifier, password } = req.body;
    const id = norm(identifier || email || username);

    if (!id) return res.status(400).json({ error: '请输入邮箱或用户名' });
    if (!password) return res.status(400).json({ error: '密码不能为空' });

    // email/username 二选一匹配（兼容你前端只传 email）
    const user = await prisma.user.findFirst({
      where: {
        OR: [
          { email: id },
          { username: id }
        ]
      }
    });

    // 重要：不要用 404 代表“账号不存在”，否则你永远以为路由没挂
    if (!user) return res.status(401).json({ error: '账号或密码错误' });

    let ok = false;

    if (isBcryptHash(user.password)) {
      ok = await bcrypt.compare(password, user.password);
    } else {
      // 兼容旧明文密码
      ok = (user.password === password);
      if (ok) {
        const upgraded = await bcrypt.hash(password, 10);
        await prisma.user.update({ where: { id: user.id }, data: { password: upgraded } });
      }
    }

    if (!ok) return res.status(401).json({ error: '账号或密码错误' });

    const token = jwt.sign({ userId: user.id, role: user.role }, JWT_SECRET);
    return res.json({ user, token });
  } catch (e) {
    return res.status(500).json({ error: 'Login failed' });
  }
};

export const getProfile = async (req: Request, res: Response) => {
  // @ts-ignore
  const user = await prisma.user.findUnique({ where: { id: req.userId } });
  return res.json(user);
};

