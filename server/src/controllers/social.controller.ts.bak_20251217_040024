
import { Request, Response } from 'express';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();

// --- Post ---
export const createPost = async (req: Request, res: Response) => {
  const { content, images, topics, visibility } = req.body;
  const userId = (req as any).user.id;

  try {
    const post = await prisma.post.create({
      data: {
        content,
        images: (images || []).join(','), // Join array to string
        topics: (topics || []).join(','), // Join array to string
        visibility: visibility || 'public',
        userId,
      },
    });
    res.status(201).json({ 
        ...post, 
        images: post.images.split(',').filter(i => i), // Split back to array
        topics: post.topics.split(',').filter(t => t)  // Split back to array
    });
  } catch (error) {
    console.error('Failed to create post:', error);
    res.status(500).json({ error: 'Failed to create post' });
  }
};

export const getPosts = async (req: Request, res: Response) => {
  const { page = 1, limit = 10 } = req.query;
  try {
    const posts = await prisma.post.findMany({
      include: {
        user: { select: { id: true, username: true, avatar: true, isVerified: true } },
        _count: { select: { likes: true, comments: true } },
      },
      orderBy: { createdAt: 'desc' },
      skip: (Number(page) - 1) * Number(limit),
      take: Number(limit),
    });

    const processedPosts = posts.map(post => ({
      ...post,
      images: post.images.split(',').filter(i => i),
      topics: post.topics.split(',').filter(t => t),
    }));

    res.json({ posts: processedPosts });
  } catch (error) {
    console.error('Failed to retrieve posts:', error);
    res.status(500).json({ error: 'Failed to retrieve posts' });
  }
};

