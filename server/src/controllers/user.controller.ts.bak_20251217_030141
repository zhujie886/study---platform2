import { Request, Response } from 'express';
import prisma from '../utils/prisma';
import jwt from 'jsonwebtoken';
import bcrypt from 'bcryptjs';

const JWT_SECRET = process.env.JWT_SECRET;

if (!JWT_SECRET) {
    throw new Error("JWT_SECRET is not defined in the environment variables");
}

// ------------------------------
// Minimal helpers (keep behavior stable)
// ------------------------------
const isBcryptHash = (v: string) =>
    typeof v === 'string' && (v.startsWith('$2a$') || v.startsWith('$2b$') || v.startsWith('$2y$'));

const normalize = (v: any) => (typeof v === 'string' ? v.trim() : '');

const emailHasAt = (v: string) => v.includes('@');

const defaultUsernameFromEmail = (email: string) => {
    const idx = email.indexOf('@');
    if (idx > 0) return email.slice(0, idx);
    return email;
};

export const register = async (req: Request, res: Response) => {
    try {
        const { username, password, email } = req.body;

        const normEmail = normalize(email);
        const normUsername = normalize(username);

        if (!normEmail || !emailHasAt(normEmail)) {
            return res.status(400).json({ error: "邮箱格式不正确：只需要包含 @ 即可" });
        }
        if (!password) {
            return res.status(400).json({ error: "密码不能为空" });
        }

        // Prisma schema requires username (String), so we auto-fill if omitted
        const finalUsername = normUsername || defaultUsernameFromEmail(normEmail);

        const hashedPassword = await bcrypt.hash(password, 10);
        const user = await prisma.user.create({
            data: {
                username: finalUsername,
                password: hashedPassword,
                email: normEmail
            }
        });

        // 保持原行为：注册返回 user（前端如果需要 token，可继续走登录）
        res.json(user);
    } catch (e) {
        res.status(400).json({ error: "User exists or error" });
    }
};

export const login = async (req: Request, res: Response) => {
    try {
        const { email, username, identifier, password } = req.body;

        const loginId = normalize(identifier || email || username);
        if (!loginId) {
            return res.status(400).json({ error: "请输入邮箱或用户名" });
        }
        if (!password) {
            return res.status(400).json({ error: "密码不能为空" });
        }

        let user: any = null;

        if (loginId.includes('@')) {
            // relaxed rule: only require '@' (already true)
            user = await prisma.user.findUnique({ where: { email: loginId } });
        } else {
            // username is not unique in schema, but this keeps behavior stable for your app
            user = await prisma.user.findFirst({ where: { username: loginId } });
        }

        if (!user) return res.status(404).json({ error: "User not found" });

        // Compat: accept legacy plaintext password and auto-upgrade to bcrypt on first success
        let ok = false;
        if (isBcryptHash(user.password)) {
            ok = await bcrypt.compare(password, user.password);
        } else {
            ok = (user.password === password);
            if (ok) {
                const upgraded = await bcrypt.hash(password, 10);
                await prisma.user.update({ where: { id: user.id }, data: { password: upgraded } });
                user = await prisma.user.findUnique({ where: { id: user.id } });
            }
        }

        if (!ok) return res.status(401).json({ error: "Invalid credentials" });

        const token = jwt.sign({ userId: user.id, role: user.role }, JWT_SECRET);
        res.json({ user, token });
    } catch (e) {
        res.status(500).json({ error: "Login failed" });
    }
};

export const getProfile = async (req: Request, res: Response) => {
    // req.userId comes from your auth middleware typing; keep as-is
    // @ts-ignore
    const user = await prisma.user.findUnique({ where: { id: req.userId } });
    res.json(user);
};

export const updateProfile = async (req: Request, res: Response) => {
    res.json({ success: true });
};

export const getUserById = async (req: Request, res: Response) => {
    const user = await prisma.user.findUnique({ where: { id: req.params.userId } });
    res.json(user);
};
