/**
 * 辅助函数：检查时间冲突
 */
async function checkTimeConflicts(
  userId: string,
  startTime: Date,
  endTime: Date,
  excludeId?: string
): Promise<any[]> {
  const where: any = {
    userId,
    OR: [
      {
        AND: [
          { startTime: { lte: startTime } },
          { endTime: { gt: startTime } }
        ]
      },
      {
        AND: [
          { startTime: { lt: endTime } },
          { endTime: { gte: endTime } }
        ]
      },
      {
        AND: [
          { startTime: { gte: startTime } },
          { endTime: { lte: endTime } }
        ]
      }
    ]
  };

  if (excludeId) {
    where.id = { not: excludeId };
  }

  return await prisma.calendar.findMany({ where });
}
