import express from 'express';
import { authenticateToken } from '../middleware/auth.middleware';
import { createPoll, listPollsByRoom, submitPollAnswer, getPollResults } from '../controllers/poll.controller';

const router = express.Router();

router.post('/', authenticateToken, createPoll);
router.get('/room/:roomId', authenticateToken, listPollsByRoom);
router.post('/:id/answer', authenticateToken, submitPollAnswer);
router.get('/:id/results', authenticateToken, getPollResults);

export default router;