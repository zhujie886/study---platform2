import express from 'express';
import cors from 'cors';
import helmet from 'helmet';
import morgan from 'morgan';
import dotenv from 'dotenv';
import { createServer } from 'http';
import { Server } from 'socket.io';
import path from 'path';

dotenv.config();

// 路由导入
import memoRoutes from './routes/memo.routes';
import calendarRoutes from './routes/calendar.routes';
import timelineRoutes from './routes/timeline.routes';
import userRoutes from './routes/user.routes';
import { login as usersLogin, register as usersRegister } from './controllers/user.controller';
import uploadRoutes from './routes/upload.routes';
import bookingRoutes from './routes/booking.routes';
import videoRoutes from './routes/video.routes';
import whiteboardRoutes from './routes/whiteboard.routes';
import pollRoutes from './routes/poll.routes';
import breakoutRoutes from './routes/breakout.routes';
import captionsRoutes from './routes/captions.routes';
import socialRoutes from './routes/social.routes';
import followRoutes from './routes/follow.routes';
import messageRoutes from './routes/message.routes';
import meetingRoutes from './routes/meeting.routes';
import adminRoutes from './routes/admin.routes';
import newRoutes from './routes/new_routes';
import reviewRoutes from './routes/review.routes';

// 服务导入
import { initializeSocketServer } from './services/socket.service';
import { startReminderService } from './services/reminder.service';

const app = express();
// ★★★★★ 关键修复：修改端口为 3001，避免与 Vite 的 3000 端口冲突
const PORT = process.env.PORT || 3000;

const httpServer = createServer(app);

app.use(cors({
  origin: true, // 允许所有来源，或指定前端地址 'http://localhost:5173'
  credentials: true,
  methods: ['GET', 'POST', 'PUT', 'DELETE', 'OPTIONS'],
  allowedHeaders: ['Content-Type', 'Authorization']
}));

const io = new Server(httpServer, {
  cors: {
    origin: "*", // 允许所有来源
    methods: ['GET', 'POST'],
    credentials: true
  }
});

app.use(helmet({
  crossOriginResourcePolicy: { policy: "cross-origin" }
}));

app.use(morgan('dev'));
app.use(express.json({ limit: '10mb' }));
app.use(express.urlencoded({ extended: true, limit: '10mb' }));

// 健康检查路由
app.get('/health', (req, res) => {
  res.json({ status: 'ok', timestamp: new Date().toISOString() });
});

// 静态文件服务
app.use('/uploads', express.static(path.resolve(__dirname, '..', 'uploads')));

// API 路由
app.use('/api/users', userRoutes);
app.use('/api/memos', memoRoutes);
app.use('/api/calendars', calendarRoutes);
app.use('/api/timelines', timelineRoutes);
app.use('/api/upload', uploadRoutes);
app.use('/api/booking', bookingRoutes);
app.use('/api/video', videoRoutes);
app.use('/api/whiteboard', whiteboardRoutes);
app.use('/api/poll', pollRoutes);
app.use('/api/breakout', breakoutRoutes);
app.use('/api/captions', captionsRoutes);
app.use('/api/social', socialRoutes);
app.use('/api/follow', followRoutes);
app.use('/api/messages', messageRoutes);
app.use('/api/meeting', meetingRoutes);
app.use('/api/admin', adminRoutes);
app.use('/api/new', newRoutes);
app.use('/api/reviews', reviewRoutes);


app.post('/api/users/register', usersRegister);
app.post('/api/users/login', usersLogin);
// 404 错误处理
app.use((req, res) => {
  res.status(404).json({ error: 'Route not found' });
});

// 全局错误处理中间件
app.use((err: any, req: express.Request, res: express.Response, next: express.NextFunction) => {
  console.error(`[${new Date().toISOString()}] Error: ${err.message}`, err.stack);
  res.status(err.status || 500).json({
    error: process.env.NODE_ENV === 'production' ? 'Internal Server Error' : err.message
  });
});

// 初始化服务
initializeSocketServer(io);
startReminderService();

// ★★★★★ 关键修复：使用 httpServer 监听，而不是 app.listen
httpServer.listen(PORT, () => {
  console.log(`🚀 Server running on http://localhost:${PORT}`);
});

export { io };
