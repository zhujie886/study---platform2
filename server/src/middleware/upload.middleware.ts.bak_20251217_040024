/**
 * 文件上传中间件
 * 使用 multer 处理 multipart/form-data
 */

import multer from 'multer';
import path from 'path';
import { Request } from 'express';
import { validateFileType, validateFileSize } from '../utils/fileStorage';

// 文件大小限制（MB）
const FILE_SIZE_LIMITS = {
  avatar: 5,      // 头像 5MB
  post: 10,       // 动态图片 10MB
  video: 100,     // 视频 100MB
  document: 20,   // 文档 20MB
  recording: 500  // 会议录制 500MB
};

// 允许的文件类型
const ALLOWED_TYPES = {
  avatar: ['.jpg', '.jpeg', '.png', '.gif', '.webp'],
  post: ['.jpg', '.jpeg', '.png', '.gif', '.webp'],
  video: ['.mp4', '.webm', '.mov', '.avi'],
  document: ['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx'],
  recording: ['.mp4', '.webm']
};

// 内存存储配置（小文件）
const memoryStorage = multer.memoryStorage();

// 文件过滤器
const createFileFilter = (category: keyof typeof ALLOWED_TYPES) => {
  return (req: Request, file: Express.Multer.File, cb: multer.FileFilterCallback) => {
    const allowedTypes = ALLOWED_TYPES[category];
    const isValidType = validateFileType(file.originalname, allowedTypes);
    
    if (isValidType) {
      cb(null, true);
    } else {
      cb(new Error(`只允许上传以下类型的文件: ${allowedTypes.join(', ')}`));
    }
  };
};

// 创建上传中间件
function createUploadMiddleware(
  category: keyof typeof FILE_SIZE_LIMITS,
  fieldName: string = 'file',
  maxCount: number = 1
) {
  return multer({
    storage: memoryStorage,
    limits: {
      fileSize: FILE_SIZE_LIMITS[category] * 1024 * 1024,
      files: maxCount
    },
    fileFilter: createFileFilter(category as any)
  });
}

// 导出各类上传中间件

/**
 * 头像上传（单文件）
 */
export const uploadAvatar = createUploadMiddleware('avatar', 'avatar').single('avatar');

/**
 * 动态图片上传（多文件，最多9张）
 */
export const uploadPostImages = createUploadMiddleware('post', 'images', 9).array('images', 9);

/**
 * 视频上传（单文件）
 */
export const uploadVideo = createUploadMiddleware('video', 'video').single('video');

/**
 * 文档上传（单文件）
 */
export const uploadDocument = createUploadMiddleware('document', 'document').single('document');

/**
 * 会议录制上传（单文件）
 */
export const uploadRecording = createUploadMiddleware('recording', 'recording').single('recording');

/**
 * 通用文件上传
 */
export const uploadAny = multer({
  storage: memoryStorage,
  limits: {
    fileSize: 100 * 1024 * 1024, // 默认100MB
    files: 10
  }
}).any();

/**
 * 错误处理中间件
 */
export function handleUploadError(error: any, req: any, res: any, next: any) {
  if (error instanceof multer.MulterError) {
    if (error.code === 'LIMIT_FILE_SIZE') {
      return res.status(400).json({ error: '文件大小超出限制' });
    }
    if (error.code === 'LIMIT_FILE_COUNT') {
      return res.status(400).json({ error: '文件数量超出限制' });
    }
    return res.status(400).json({ error: `文件上传错误: ${error.message}` });
  }
  
  if (error) {
    return res.status(400).json({ error: error.message });
  }
  
  next();
}