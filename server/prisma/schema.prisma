// Prisma Schema for SQLite (Local Dev)
// Optimized with indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== 用户系统 ====================

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  password      String
  avatar        String?
  bio           String?
  phone         String?
  isVerified    Boolean        @default(false)
  isConsultant  Boolean        @default(false)
  consultFee    Float?         @default(0)
  specialties   String?        // JSON
  rating        Float?         @default(0)
  totalBookings Int            @default(0)
  weeklySchedule String?       // JSON
  pricingRules  String?        // JSON
  isMuted       Boolean        @default(false)
  mutedUntil    DateTime?
  muteReason    String?
  mutedAt       DateTime?
  mutedBy       String?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  memos         Memo[]
  sharedMemos   SharedMemo[]
  events        Calendar[]
  timelines     Timeline[]
  meetingRecords MeetingRecord[]
  reminderTasks ReminderTask[]

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  favorites     Favorite[]
  questions     Question[]
  answers       Answer[]
  attachments   Attachment[]
  acceptedAnswers AcceptedAnswer[] @relation("AcceptedBy")
  createdTags   Tag[] @relation("TagCreator")
  consultantProfile ConsultantProfile?
  services      Service[]
  availabilityRules AvailabilityRule[]
  following     Follow[]      @relation("UserFollowing")
  followers     Follow[]      @relation("UserFollowers")
  sentMessages  Message[]     @relation("MessageSender")
  receivedMessages Message[]  @relation("MessageReceiver")

  availableSlots    AvailableSlot[]
  sentBookings      Booking[]   @relation("BookingRequester")
  receivedBookings  Booking[]   @relation("BookingConsultant")
  bookingReviews    BookingReview[]

  hostedRooms       VideoRoom[] @relation("RoomHost")
  roomParticipants  RoomParticipant[]
  whiteboardActions WhiteboardAction[]
  pollResponses     PollResponse[]
  sentInvitations   MeetingInvitation[] @relation("SentInvitations")
  receivedInvitations MeetingInvitation[] @relation("ReceivedInvitations")

  payments          Payment[]   @relation("PaymentPayer")
  earnings          Payment[]   @relation("PaymentPayee")

  @@index([email])
  @@index([username])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ==================== 社交平台 ====================

model Post {
  id          String    @id @default(uuid())
  userId      String
  content     String
  images      String?   // JSON
  videoUrl    String?
  topics      String?   // JSON
  type        String    @default("status") // status | question
  visibility  String    @default("public")
  viewCount   Int       @default(0)
  shareCount  Int       @default(0)
  likeCount   Int       @default(0)
  commentCount Int      @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  favorites   Favorite[]

  @@index([userId])
  @@index([createdAt])
  @@index([type])
}

model Comment {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  content     String
  replyToId   String?
  replyToUserId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Favorite {
  id          String   @id @default(uuid())
  postId      String
  userId      String
  createdAt   DateTime @default(now())

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model Message {
  id          String   @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  imageUrl    String?
  voiceUrl    String?
  isRead      Boolean  @default(false)

  createdAt   DateTime @default(now())

  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User     @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ==================== Q&A ====================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  questions   Question[]
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isApproved  Boolean   @default(true)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy   User?     @relation("TagCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions   QuestionTag[]

  @@index([name])
  @@index([isApproved])
}

model Question {
  id              String    @id @default(uuid())
  userId          String
  categoryId      String
  title           String
  content         String
  contentFormat   String    @default("markdown")
  isAnonymous     Boolean   @default(false)
  status          String    @default("open")
  acceptedAnswerId String?   @unique
  viewCount       Int       @default(0)
  answerCount     Int       @default(0)
  bountyPoints    Int?
  bountyAmount    Float?
  resolvedAt      DateTime?
  editedAt        DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id])
  tags            QuestionTag[]
  attachments     Attachment[]
  answers         Answer[]
  acceptedAnswer  Answer?   @relation("AcceptedAnswer", fields: [acceptedAnswerId], references: [id])
  acceptedHistory AcceptedAnswer[]

  @@index([userId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model QuestionTag {
  id          String    @id @default(uuid())
  questionId  String
  tagId       String
  createdAt   DateTime  @default(now())

  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([questionId, tagId])
  @@index([tagId])
}

model Answer {
  id            String    @id @default(uuid())
  questionId    String
  userId        String
  content       String
  contentFormat String    @default("markdown")
  isAnonymous   Boolean   @default(false)
  status        String    @default("active")
  voteCount     Int       @default(0)
  editedAt      DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   Attachment[]
  acceptedFor   Question? @relation("AcceptedAnswer")
  acceptedHistory AcceptedAnswer[]

  @@index([questionId])
  @@index([userId])
  @@index([createdAt])
}

model Attachment {
  id          String    @id @default(uuid())
  uploaderId  String
  questionId  String?
  answerId    String?
  url         String
  name        String?
  size        Int?
  mimeType    String?
  type        String    @default("file")
  createdAt   DateTime  @default(now())

  uploader    User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer      Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
  @@index([questionId])
  @@index([answerId])
}

model AcceptedAnswer {
  id           String    @id @default(uuid())
  questionId   String
  answerId     String
  acceptedById String
  acceptedAt   DateTime  @default(now())
  revokedAt    DateTime?

  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer       Answer    @relation(fields: [answerId], references: [id], onDelete: Cascade)
  acceptedBy   User      @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([answerId])
  @@index([acceptedById])
}

// ==================== Post / 服务 ====================

model ConsultantProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  headline          String?
  skills            String?  // JSON
  portfolioLinks    String?  // JSON
  languages         String?  // JSON
  timezone          String?  @default("Asia/Shanghai")
  primaryDomain     String?
  secondaryDomains  String?  // JSON
  projects          String?  // JSON
  certifications    String?  // JSON
  ratingAvg         Float    @default(0)
  ratingCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id              String   @id @default(uuid())
  consultantId    String
  title           String
  description     String?
  price           Float
  currency        String   @default("CNY")
  durationMinutes Int
  deliveryType    String   @default("meeting")
  scope           String?
  deliverables    String?
  notes           String?
  tagsJson        String?  // JSON
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  consultant      User     @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@index([consultantId])
  @@index([isActive])
}

model AvailabilityRule {
  id            String   @id @default(uuid())
  consultantId  String
  dayOfWeek     Int
  startTime     String
  endTime       String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultant    User     @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  @@index([consultantId])
  @@index([dayOfWeek])
}

// ==================== 预约系统 ====================

model AvailableSlot {
  id          String    @id @default(uuid())
  userId      String
  date        DateTime
  startTime   String
  endTime     String
  isBooked    Boolean   @default(false)
  price       Float     @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    Booking[]

  @@index([userId])
  @@index([date])
}

model Booking {
  id            String    @id @default(uuid())
  slotId        String?
  serviceId     String?
  requesterId   String
  consultantId  String
  skill         String
  purpose       String
  duration      Int
  amount        Float
  status        String    @default("pending")
  cancelReason  String?
  refundAmount  Float?
  rescheduleCount Int     @default(0)
  questionText  String?

  roomId        String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  slot          AvailableSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  requester     User          @relation("BookingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  consultant    User          @relation("BookingConsultant", fields: [consultantId], references: [id], onDelete: Cascade)
  payment       Payment?
  review        BookingReview?

  @@index([requesterId])
  @@index([consultantId])
  @@index([status])
  @@index([serviceId])

  startAt DateTime? // added by fix_all_doctor_issues.py
  endAt DateTime? // added by fix_all_doctor_issues.py
}

model BookingReview {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  userId      String
  consultantId String
  rating      Int
  content     String?
  images      String?  // JSON
  reply       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([consultantId])
}

model Payment {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  payerId       String
  payeeId       String
  amount        Float
  status        String   @default("pending")
  paymentMethod String   @default("simulate")
  transactionId String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payer         User     @relation("PaymentPayer", fields: [payerId], references: [id], onDelete: Cascade)
  payee         User     @relation("PaymentPayee", fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([payerId])
  @@index([status])

  grossAmount Float? // added by fix_all_doctor_issues.py
  netAmount Float? // added by fix_all_doctor_issues.py
  paidAt DateTime? // added by fix_all_doctor_issues.py
}

// ==================== 视频会议系统 ====================

model VideoRoom {
  id              String    @id @default(uuid())
  hostId          String
  roomNumber      String    @unique
  password        String?
  title           String
  description     String?
  maxParticipants Int       @default(100)
  enableWaitingRoom Boolean @default(false)
  enableRecording Boolean   @default(false)
  enableWhiteboard Boolean  @default(true)
  enableScreenShare Boolean @default(true)
  enableBarrage   Boolean   @default(true)

  inviteLink      String?   @unique
  linkExpiry      DateTime?
  linkType        String    @default("permanent")
  joinPermission  String    @default("invited")
  customLinkName  String?

  status          String    @default("scheduled")
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  recordingUrl    String?
  recordingPassword String?
  recordingVisibility String @default("participants")

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  host            User      @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  participants    RoomParticipant[]
  whiteboards     Whiteboard[]
  polls           Poll[]
  chatMessages    ChatMessage[]
  barrages        Barrage[]
  breakoutRooms   BreakoutRoom[]
  invitations     MeetingInvitation[]

  @@index([hostId])

  scheduled Boolean? // added by fix_all_doctor_issues.py
}

model RoomParticipant {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  role        String   @default("participant")

  isMuted     Boolean  @default(false)
  isVideoOff  Boolean  @default(false)
  isHandRaised Boolean @default(false)
  isScreenSharing Boolean @default(false)
  canEditWhiteboard Boolean @default(false)
  isViewingWhiteboard Boolean @default(false)

  joinedAt    DateTime @default(now())
  leftAt      DateTime?

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId])

  linkExpiry DateTime? // added by fix_all_doctor_issues.py
  username String? // added by fix_all_doctor_issues.py
}

model ChatMessage {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  username    String
  content     String
  isPrivate   Boolean  @default(false)
  targetUserId String?

  createdAt   DateTime @default(now())

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model Whiteboard {
  id          String   @id @default(uuid())
  roomId      String
  pageNumber  Int      @default(1)
  thumbnail   String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  actions     WhiteboardAction[]

  @@index([roomId])
}

model WhiteboardAction {
  id            String   @id @default(uuid())
  whiteboardId  String
  userId        String
  actionType    String
  actionData    String   // JSON

  createdAt     DateTime @default(now())

  whiteboard    Whiteboard @relation(fields: [whiteboardId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([whiteboardId])
}

model BreakoutRoom {
  id          String   @id @default(uuid())
  mainRoomId  String
  roomName    String
  members     String   // JSON

  createdAt   DateTime @default(now())
  endedAt     DateTime?

  mainRoom    VideoRoom @relation(fields: [mainRoomId], references: [id], onDelete: Cascade)

  @@index([mainRoomId])
}

model Poll {
  id          String   @id @default(uuid())
  roomId      String
  question    String
  options     String   // JSON
  pollType    String
  correctAnswer String? // JSON

  createdAt   DateTime @default(now())
  endedAt     DateTime?

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  responses   PollResponse[]

  @@index([roomId])
}

model PollResponse {
  id          String   @id @default(uuid())
  pollId      String
  userId      String
  answer      String   // JSON
  isCorrect   Boolean?

  createdAt   DateTime @default(now())

  poll        Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Memo {
  id               String         @id @default(uuid())
  userId           String
  title            String
  content          String
  encryptedContent String?
  encryptionSalt   String?
  labels           String?
  priority         Int            @default(0)
  color            String?
  status           String         @default("active")
  isEncrypted      Boolean        @default(false)
  isStarred        Boolean        @default(false)
  isArchived       Boolean        @default(false)
  reminderTime     DateTime?
  locationReminder String?
  attachments      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sharedWith       SharedMemo[]

  @@index([userId])
}

model SharedMemo {
  id            String   @id @default(uuid())
  memoId        String
  sharedWithId  String
  permission    String         @default("read")
  createdAt     DateTime       @default(now())
  memo          Memo           @relation(fields: [memoId], references: [id], onDelete: Cascade)
  sharedWith    User           @relation(fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([memoId, sharedWithId])
  @@index([sharedWithId])
}

model Calendar {
  id            String         @id @default(uuid())
  userId        String
  eventTitle    String
  description   String?
  location      String?
  startTime     DateTime
  endTime       DateTime
  isAllDay      Boolean        @default(false)
  recurrence    String?
  color         String?
  reminders     String?
  attendees     String?
  timezone      String?        @default("Asia/Shanghai")
  source        String?        @default("manual")
  memoId        String?
  status        String         @default("confirmed")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime])
}

model Timeline {
  id                String         @id @default(uuid())
  userId            String
  date              DateTime
  timeBlocks        String?
  tasks             String?
  utilizationRate   Float?         @default(0)
  totalWorkTime     Int?           @default(0)
  statistics        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], name: "userId_date")
  @@index([userId])
}

model MeetingRecord {
  id            String         @id @default(uuid())
  userId        String
  title         String
  content       String
  meetingDate   DateTime
  participants  String?
  actionItems   String?
  tags          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReminderTask {
  id            String         @id @default(uuid())
  userId        String
  title         String
  description   String?
  triggerTime   DateTime
  status        String         @default("pending")
  type          String
  relatedId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([triggerTime])
}

model Barrage {
  id          String   @id @default(uuid())
  roomId      String
  userId      String
  username    String 
  content     String
  emoji       String?
  mentionUserId String?
  isPinned    Boolean  @default(false)
  pinnedUntil DateTime?
  isRevoked   Boolean  @default(false)
  colorHash   String

  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
}

model MeetingInvitation {
  id          String   @id @default(uuid())
  roomId      String
  inviterId   String
  inviteeId   String
  status      String   @default("pending")
  message     String?

  createdAt   DateTime @default(now())
  respondedAt DateTime?

  room        VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter     User      @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User      @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([roomId, inviteeId])
  @@index([inviteeId])
}
